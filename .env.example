# Copier ce fichier en .env et renseigner les valeurs. Ne jamais commiter .env.

# Azure OpenAI (ressource en France Central) : URL de la ressource et clé.
# az cognitiveservices account show -n <ressource> -g <groupe> --query properties.endpoint
AZURE_OPENAI_ENDPOINT=
# az cognitiveservices account keys list -n <ressource> -g <groupe>  (ne jamais commiter la clé)
AZURE_OPENAI_API_KEY=

# Clé protégeant les endpoints d'administration de l'API (/reload, en-tête X-API-Key).
# Laisser vide désactive ces endpoints.
ADMIN_API_KEY=
